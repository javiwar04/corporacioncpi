# ─────────────────────────────────────────────────────────────
# Corporación CPI — variables de entorno
# Copia este archivo como `.env.local` y completa los valores.
# NO subas `.env.local` al repositorio. NO pongas credenciales reales aquí.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (para metadatos SEO / Open Graph absolutos)
NEXT_PUBLIC_SITE_URL=https://corporacioncpi.com

# ── Contacto ──────────────────────────────────────────────────
# Número de WhatsApp en formato internacional SIN "+" ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=50231470464
# Teléfono mostrado (formato libre)
NEXT_PUBLIC_PHONE=+502 2333 7054
# Correo de contacto (PENDIENTE de confirmar — ver CONTENT_TODO.md)
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Mapa geográfico (Nivel 1) ─────────────────────────────────
# Proveedor de tiles: "osm" (OpenStreetMap, gratis, por defecto) | "mapbox" | "maptiler"
NEXT_PUBLIC_MAP_PROVIDER=osm
# Plantilla de tiles personalizada (opcional). Deja vacío para usar el default del proveedor.
# Ej. Mapbox: https://api.mapbox.com/styles/v1/mapbox/light-v11/tiles/{z}/{x}/{y}?access_token=TOKEN
NEXT_PUBLIC_MAP_TILE_URL=
# Clave del proveedor de tiles (solo si usas mapbox/maptiler). NO commitear la real.
NEXT_PUBLIC_MAP_TILE_KEY=

# ── Herramientas de desarrollo ────────────────────────────────
# Habilita /dev/masterplan-editor en producción (por defecto bloqueado). Deja vacío en producción.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=

# ── Formulario de contacto (opcional / futuro) ────────────────
# Endpoint al que se enviará el formulario "Solicitar información".
NEXT_PUBLIC_LEADS_ENDPOINT=
